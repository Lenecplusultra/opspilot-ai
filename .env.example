# Copy to .env and fill in. .env is git-ignored; never commit it.
#   cp .env.example .env

# Required for the Copilot chat and real-model evals
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local runs without Docker. Docker Compose sets its own DATABASE_URL.
# Leave unset to use SQLite (backend/opspilot.db).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/opspilot

# JWT signing key: use a long random string outside local dev
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# development: create tables and seed demo users + the demo incident on startup
ENVIRONMENT=development
DEMO_SCENARIO=payments_stuck_worker

# Optional: point the GitHub tool at a real repository instead of scenario fixtures
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=
